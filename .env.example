# ---- Facebook ----
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Normally set by `reel-cli facebook pages`
FACEBOOK_PAGE_ID=
# Optional override. Normally `reel-cli facebook login` stores the Page token in the OS keychain.
FACEBOOK_PAGE_ACCESS_TOKEN=
GRAPH_API_VERSION=v26.0
# `reel-cli facebook login` listens on http://localhost:PORT/callback.
# Meta allows localhost redirects automatically while the app is in Development mode.
FACEBOOK_OAUTH_PORT=8585

# ---- Publishing ----
# Meta allows 30 API-published Reels per rolling 24h; keep a safety margin
QUOTA_PER_24H=25
# Videos longer than this are published as regular Page videos (not Reels).
# Meta's Reels API docs say 90; raise only if Phase 0 Test C proves longer works.
REEL_MAX_DURATION_S=90
# Default daily posting times for `reel-cli schedule` (local TIMEZONE). "none" disables a target.
REEL_SLOTS=09:00,14:00,20:00
VIDEO_SLOTS=12:00,18:00
MAX_RETRIES=3
# Uploads of ANY kind (Reels + Page videos + drafts) per rolling 24h. Facebook blocks accounts that
# upload too much too fast (error 368/1390008), whatever the endpoint, so keep this conservative.
DAILY_UPLOAD_LIMIT=25
# Minimum seconds between two uploads, so a batch never bursts
MIN_UPLOAD_GAP_SECONDS=120
# Videos uploaded in parallel by `reel-cli publish` (1-5). Keep 1 unless you know your Page tolerates more.
PUBLISH_CONCURRENCY=1
WORKER_INTERVAL_SECONDS=30
TIMEZONE=Asia/Kolkata

# ---- Instagram (optional) ----
# Instagram posts published per rolling 24h (Instagram allows 100; stay conservative)
INSTAGRAM_DAILY_LIMIT=25
# Upload and process each Instagram video this many hours before its publish time (max 20; containers expire after 24h)
INSTAGRAM_PREPARE_HOURS=3

# ---- AI ----
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
TRANSCRIPTION_PROVIDER=whisper-cpp
WHISPER_MODEL=small
# Path to whisper.cpp CLI if not on PATH as `whisper-cli`
WHISPER_BINARY=

# ---- Paths / logging ----
DATABASE_URL=./data/reels.db
LOG_LEVEL=info
